# URL publique du site (utilisée pour le sitemap, robots.txt et les métadonnées)
NEXT_PUBLIC_SITE_URL=https://www.vivrebio.bj

# Espace admin (/admin) — mot de passe partagé de l'équipe VIVRE BIO
ADMIN_PASSWORD=change-me
# Clé utilisée pour signer le cookie de session admin — chaîne longue et aléatoire
SESSION_SECRET=change-me-too

# SMTP pour l'envoi des emails (notification de commande + formulaire de contact)
# Si ces variables sont absentes, les emails ne sont pas envoyés (mais rien ne bloque).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@vivrebio.bj

# Adresse qui reçoit les notifications de commande et les messages du formulaire de contact
ORDER_NOTIFICATION_EMAIL=commandes@vivrebio.bj

# Turso (libSQL cloud) — utilisé en production sur Netlify à la place du
# fichier SQLite local (le filesystem des Lambda est read-only). En dev, ces
# variables sont ignorées : le code ouvre `data/vivrebio.db` en local.
# Récupère les valeurs sur https://app.turso.tech → ta DB → "Connect".
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# FedaPay (paiement en ligne optionnel) — récupère la clé publique sur
# https://dashboard.fedapay.com (mode sandbox pour les tests), et la clé
# secrète du webhook lors de la création du endpoint dans le dashboard
# (Paramètres → Webhooks). Le mode sandbox/live est déduit automatiquement
# du préfixe de FEDAPAY_PUBLIC_KEY (pk_sandbox_... / pk_live_...).
FEDAPAY_PUBLIC_KEY=
FEDAPAY_WEBHOOK_SECRET=
