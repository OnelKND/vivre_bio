# URL publique du site (utilisée pour le sitemap, robots.txt et les métadonnées)
NEXT_PUBLIC_SITE_URL=https://www.vivrebio.bj

# Espace admin (/admin) — mot de passe partagé de l'équipe VIVRE BIO
ADMIN_PASSWORD=change-me
# Clé utilisée pour signer le cookie de session admin — chaîne longue et aléatoire
SESSION_SECRET=change-me-too

# SMTP pour l'envoi des emails (notification de commande + formulaire de contact)
# Si ces variables sont absentes, les emails ne sont pas envoyés (mais rien ne bloque).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@vivrebio.bj

# Adresse qui reçoit les notifications de commande et les messages du formulaire de contact
ORDER_NOTIFICATION_EMAIL=commandes@vivrebio.bj
